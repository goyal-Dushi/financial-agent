# Buy or Wait? — environment template. Copy to the repo root as `.env` (or to
# code/.env) and fill in your own values. Never commit real secrets.

# Single OpenRouter key shared by EVERY agent (Query Analyser, Data Generator,
# Vision/OCR structuring, Image Tabularizer, Aggregator). There is no separate
# vision key: image-to-text is done locally by RapidOCR, and the LLM only reads
# that text, so an ordinary text model works. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

# Optional per-agent model overrides (blank/absent falls back to OPENROUTER_MODEL).
QUERY_ANALYSER_MODEL=
DATA_GENERATOR_MODEL=
VISION_MODEL=
IMAGE_TABULARIZER_MODEL=
AGGREGATOR_MODEL=

LLM_TEMPERATURE=0

# Optional path overrides (blank uses defaults: dataset/ at repo root).
DATASET_DIR=
OUTPUT_DIR=
